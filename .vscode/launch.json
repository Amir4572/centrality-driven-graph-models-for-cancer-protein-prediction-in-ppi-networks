{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch Web App (FastAPI + React)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--serve", "--host", "127.0.0.1", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Run Full Training Pipeline (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Predict Sample Proteins (TP53, BRCA1, SP1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--predict", "TP53", "BRCA1", "SP1"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
